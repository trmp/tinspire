<NotepadPlus>
    <UserLang name="tinspire" ext="txt">
        <Settings>
            <Global caseIgnored="yes" allowFoldOfComments="no" />
            <TreatAsSymbol comment="no" commentLine="yes" />
            <Prefix words1="0" words2="0" words3="0" words4="0" />
        </Settings>
        <KeywordLists>
            <Keywords name="Delimiters">0000" 0000"</Keywords>
            <Keywords name="Folder+">Prgm Func If For While Loop Try</Keywords>
            <Keywords name="Folder-">EndPrgm EndFunc EndIf EndFor EndWhile EndLoop EndTry</Keywords>
            <Keywords name="Operators">Then Else ElseIf Return Cycle Exit Lbl Goto Stop Disp Text</Keywords>
            <Keywords name="Comment">©</Keywords>
            <Keywords name="Words1">Define getType abs amortTbl and angle ANOVA ANOVA2way Ans approx arccos arccosh arccot arccoth arccsc arccsch arcLen arcsec arcsech arcsin arcsinh arctan arctanh augment avgRC</Keywords>
            <Keywords name="Words2"></Keywords>
            <Keywords name="Words3"></Keywords>
            <Keywords name="Words4"></Keywords>
        </KeywordLists>
        <Styles>
            <WordsStyle name="DEFAULT" fgColor="000000" bgColor="FFFFFF" fontStyle="0" />
            <WordsStyle name="FOLDEROPEN" fgColor="0000FF" bgColor="FFFFFF" fontStyle="1" />
            <WordsStyle name="FOLDERCLOSE" fgColor="0000FF" bgColor="FFFFFF" fontStyle="1" />
            <WordsStyle name="KEYWORD1" fgColor="000080" bgColor="FFFFFF" fontStyle="1" />
            <WordsStyle name="KEYWORD2" fgColor="000080" bgColor="FFFFFF" fontStyle="1" />
            <WordsStyle name="KEYWORD3" fgColor="000080" bgColor="FFFFFF" fontStyle="1" />
            <WordsStyle name="KEYWORD4" fgColor="000080" bgColor="FFFFFF" fontStyle="1" />
            <WordsStyle name="COMMENT" fgColor="008000" bgColor="FFFFFF" fontStyle="2" />
            <WordsStyle name="COMMENTLINE" fgColor="008000" bgColor="FFFFFF" fontStyle="2" />
            <WordsStyle name="NUMBER" fgColor="FF0000" bgColor="FFFFFF" fontStyle="0" />
            <WordsStyle name="OPERATOR" fgColor="000000" bgColor="FFFFFF" fontStyle="1" />
            <WordsStyle name="DELIMITERS" fgColor="800000" bgColor="FFFFFF" fontStyle="0" />
            <WordsStyle name="DELIMITER1" fgColor="800000" bgColor="FFFFFF" fontStyle="0" />
        </Styles>
    </UserLang>
</NotepadPlus>
